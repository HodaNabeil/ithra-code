datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator client_js {
  provider = "prisma-client-js"
}

model Course {
  id                 String           @id @default(cuid())
  instructorId       String           @map("instructor_id")
  instructor         User             @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Restrict)
  title              String
  description        String
  shortDescription   String?          @map("short_description")
  slug               String           @unique
  thumbnailUrl       String           @map("thumbnail_url")
  previewVideo       String?          @map("preview_video")
  price              Decimal          @db.Decimal(10, 2)
  compareAtPrice     Decimal?         @map("compare_at_price") @db.Decimal(10, 2)
  currency           Currency         @default(USD)
  level              CourseLevel      @default(BEGINNER)
  status             CourseStatus     @default(DRAFT)
  visibility         CourseVisibility @default(PRIVATE)
  isFeatured         Boolean          @default(false) @map("is_featured")
  duration           Int?
  requirements       String[]
  objectives         String[]
  targetAudience     String[]         @map("target_audience")
  tags               String[]
  metaTitle          String?          @map("meta_title")
  metaDescription    String?          @map("meta_description")
  certificateEnabled Boolean          @default(true) @map("certificate_enabled")
  maxStudents        Int?             @map("max_students")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  publishedAt        DateTime?        @map("published_at")
  knowledgeIndexedAt DateTime?        @map("knowledge_indexed_at")

  pathId      String       @map("path_id")
  path        Path         @relation(fields: [pathId], references: [id])
  trackId     String?      @map("track_id")
  track       Track?       @relation(fields: [trackId], references: [id])
  sections    Section[]
  orderItems  OrderItem[]
  cartItems   CartItem[]
  reviews     Review[]
  enrollments Enrollment[]
  tutorConversations TutorConversation[]
  knowledgeChunks KnowledgeChunk[]
  knowledgeSourceHashes KnowledgeSourceHash[]
  studentLearningProfiles StudentLearningProfile[]
  indexingOutbox CourseIndexingOutbox[]

  prerequisites Course[] @relation("CoursePrerequisites")
  requiredFor   Course[] @relation("CoursePrerequisites")

  @@index([instructorId])
  @@index([status])
  @@index([visibility])
  @@index([pathId])
  @@index([trackId])
  @@index([isFeatured])
  @@index([status, visibility])
  @@index([instructorId, status])
  @@index([createdAt])
  @@map("courses")
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  UNDER_REVIEW
}

enum CourseVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum Currency {
  USD
}

enum PaymentProvider {
  PAYMOB
  STRIPE
  PAYPAL
  CASH
}

model Section {
  id          String   @id @default(cuid())
  courseId    String   @map("course_id")
  title       String
  description String?
  position    Int
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lectures Lecture[]
  knowledgeChunks KnowledgeChunk[]

  @@index([courseId])
  @@index([position])
  @@map("sections")
}

model Lecture {
  id          String      @id @default(cuid())
  sectionId   String      @map("section_id")
  title       String
  description String?
  type        LectureType @default(VIDEO)
  content     String?
  videoId     String?     @unique @map("video_id")
  position    Int
  isPublished Boolean     @default(false) @map("is_published")
  isFree      Boolean     @default(false) @map("is_free")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  section     Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  video       Video?       @relation(fields: [videoId], references: [id])
  attachments Attachment[]
  progress    Progress[]
  tutorThreads TutorThread[]
  transcript  LectureTranscript?
  knowledgeChunks KnowledgeChunk[]
  knowledgeSourceHashes KnowledgeSourceHash[]

  @@index([sectionId])
  @@index([position])
  @@map("lectures")
}

model Video {
  id           String   @id @default(cuid())
  bunnyVideoId String   @unique @map("bunny_video_id")
  libraryId    String   @map("library_id")
  duration     Int?
  thumbnailUrl String?  @map("thumbnail_url")
  status       String   @default("processing")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lecture Lecture?

  @@map("videos")
}

// Maps a Course to its dedicated Bunny Stream collection (one per course)
// inside the single shared video library. Owned by the media infrastructure
// layer to keep Bunny details out of the Course domain model.
model VideoCollection {
  id                String   @id @default(cuid())
  courseId          String   @unique @map("course_id")
  bunnyCollectionId String   @map("bunny_collection_id")
  libraryId         String   @map("library_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([libraryId])
  @@map("video_collections")
}

enum LectureType {
  VIDEO
  TEXT
  AUDIO
  QUIZ
  ASSIGNMENT
  LIVE_SESSION
  ATTACHMENT
}

enum AttachmentType {
  PDF
  VIDEO
  IMAGE
  DOC
  DOCX
  PPT
  PPTX
  XLS
  XLSX
  ZIP
  AUDIO
  LINK
  TEXT
  CODE
  HTML
  OTHER
}

model Attachment {
  id             String         @id @default(cuid())
  lectureId      String         @map("lecture_id")
  name           String
  description    String?
  type           AttachmentType
  url            String
  content        String?
  fileSize       Int?           @map("file_size")
  mimeType       String?        @map("mime_type")
  isDownloadable Boolean        @default(true) @map("is_downloadable")
  position       Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([lectureId])
  @@index([type])
  @@index([position])
  @@index([lectureId, position])
  @@map("attachments")
}

model Path {
  id               String       @id @default(cuid())
  title            String
  slug             String       @unique
  tagline          String?
  shortDescription String?      @map("short_description")
  description      String
  thumbnailUrl     String       @map("thumbnail_url")
  category         PathCategory
  icon             String?
  isPublished      Boolean      @default(false) @map("is_published")
  sortOrder        Int          @default(0) @map("sort_order")
  metaTitle        String?      @map("meta_title")
  metaDescription  String?      @map("meta_description")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  tracks  Track[]
  courses Course[]

  @@index([slug])
  @@index([category])
  @@index([isPublished])
  @@map("paths")
}

model Track {
  id               String       @id @default(cuid())
  pathId           String       @map("path_id")
  title            String
  slug             String       @unique
  shortDescription String       @map("short_description")
  description      String
  thumbnailUrl     String?      @map("thumbnail_url")
  category         PathCategory
  icon             String?
  isPublished      Boolean      @default(false) @map("is_published")
  sortOrder        Int          @default(0) @map("sort_order")
  metaTitle        String?      @map("meta_title")
  metaDescription  String?      @map("meta_description")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  path    Path     @relation(fields: [pathId], references: [id], onDelete: Cascade)
  courses Course[]

  @@index([slug])
  @@index([pathId])
  @@index([category])
  @@index([isPublished])
  @@map("tracks")
}

enum PathCategory {
  WEB
  MOBILE
  OTHER
}

// ─── Auth Models ─────────────────────────────────────────────────────────────

model User {
  id                            String    @id @default(cuid())
  name                          String?
  email                         String    @unique
  emailVerified                 DateTime? @map("email_verified")
  image                         String?   @map("profile_picture")
  password                      String?
  passwordChangedAt             DateTime? @map("password_changed_at")
  firstName                     String?   @map("first_name")
  lastName                      String?   @map("last_name")
  bio                           String?
  role                          Role      @default(STUDENT)
  isEmailVerified               Boolean   @default(false) @map("is_email_verified")
  isActive                      Boolean   @default(true) @map("is_active")
  lastLoginAt                   DateTime? @map("last_login_at")
  failedLoginCount              Int       @default(0) @map("failed_login_count")
  lockedUntil                   DateTime? @map("locked_until")
  emailVerifyToken              String?   @unique @map("email_verify_token")
  emailVerifyExpires            DateTime? @map("email_verify_expires")
  verificationResendCount       Int       @default(0) @map("verification_resend_count")
  verificationResendLastAttempt DateTime? @map("verification_resend_last_attempt")
  resetPasswordToken            String?   @unique @map("reset_password_token")
  resetPasswordExpires          DateTime? @map("reset_password_expires")
  passwordResetRequestCount     Int       @default(0) @map("password_reset_request_count")
  passwordResetLastAttempt      DateTime? @map("password_reset_last_attempt")
  passwordSetupRequestCount     Int       @default(0) @map("password_setup_request_count")
  passwordSetupLastAttempt      DateTime? @map("password_setup_last_attempt")
  timezone                      String?   @default("UTC")
  language                      String?   @default("en")
  oauthProvider                 String?   @map("oauth_provider")
  oauthProviderId               String?   @map("oauth_provider_id")
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  accounts            Account[]
  sessions            Session[]
  userSessions        UserSession[]
  courses             Course[]                    @relation("InstructorCourses")
  enrollments         Enrollment[]
  cart                Cart?
  orders              Order[]
  reviews             Review[]
  availabilities      InstructorAvailability[]
  dateOverrides       AvailabilityDateOverride[]
  scheduleSettings    InstructorScheduleSettings?
  studentBookings     ConsultationBooking[]       @relation("StudentBookings")
  instructorBookings  ConsultationBooking[]       @relation("InstructorBookings")
  googleCalendarToken GoogleCalendarToken?
  refundRequests      RefundRequest[]             @relation("UserRefundRequests")
  instructorEarnings  InstructorEarning[]         @relation("InstructorEarnings")
  trackedDevices      TrackedDevice[]
  tokenFamilies       TokenFamily[]
  checkoutSessions    CheckoutSession[]
  tutorConversations  TutorConversation[]
  studentLearningProfiles StudentLearningProfile[]
  aiAgentRuns         AiAgentRun[]
  aiUsageDaily        AiUsageDaily[]
  aiMemoryFacts       AiMemoryFact[]
  aiToolInvocations   AiToolInvocation[]

  @@unique([oauthProvider, oauthProviderId])
  @@index([email])
  @@index([emailVerifyToken])
  @@index([resetPasswordToken])
  @@map("users")
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  accessToken  String   @unique @map("access_token")
  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accessToken])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("user_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model TrackedDevice {
  id               String   @id @default(cuid())
  deviceId         String   @unique @map("device_id")
  userId           String   @map("user_id")
  deviceName       String   @map("device_name")
  deviceType       String   @map("device_type")
  os               String
  browser          String
  ipAddress        String   @map("ip_address")
  timezone         String
  screenResolution String?  @map("screen_resolution")
  language         String
  fingerprint      String
  isTrusted        Boolean  @default(false) @map("is_trusted")
  isActive         Boolean  @default(true) @map("is_active")
  loginCount       Int      @default(1) @map("login_count")
  firstSeen        DateTime @default(now()) @map("first_seen")
  lastSeen         DateTime @default(now()) @map("last_seen")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, isActive])
  @@index([fingerprint])
  @@index([expiresAt])
  @@map("tracked_devices")
}

model TokenFamily {
  id          String   @id @default(cuid())
  tokenFamily String   @unique @map("token_family")
  userId      String   @map("user_id")
  deviceId    String?  @map("device_id")
  isRevoked   Boolean  @default(false) @map("is_revoked")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deviceId])
  @@index([expiresAt])
  @@map("token_families")
}

model Enrollment {
  id          String           @id @default(cuid())
  studentId   String           @map("student_id")
  courseId    String           @map("course_id")
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now()) @map("enrolled_at")
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  student  User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course   Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress Progress[]

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  REVOKED
}

model Progress {
  id             String    @id @default(cuid())
  enrollmentId   String    @map("enrollment_id")
  lectureId      String    @map("lecture_id")
  isCompleted    Boolean   @default(false) @map("is_completed")
  completedAt    DateTime? @map("completed_at")
  lastAccessedAt DateTime  @default(now()) @map("last_accessed_at")
  timeSpent      Int       @default(0) @map("time_spent")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lecture    Lecture    @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lectureId])
  @@index([enrollmentId])
  @@index([lectureId])
  @@map("progress")
}

// ─── Shopping Cart Models ─────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  couponId  String?  @map("coupon_id")
  subtotal  Decimal  @default(0) @db.Decimal(10, 2)
  discount  Decimal  @default(0) @db.Decimal(10, 2)
  total     Decimal  @default(0) @db.Decimal(10, 2)
  currency  Currency @default(USD)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon?    @relation(fields: [couponId], references: [id])
  items  CartItem[]

  @@index([userId])
  @@index([couponId])
  @@map("carts")
}

model CartItem {
  id       String   @id @default(cuid())
  cartId   String   @map("cart_id")
  courseId String   @map("course_id")
  price    Decimal  @db.Decimal(10, 2)
  currency Currency @default(USD)
  addedAt  DateTime @default(now()) @map("added_at")

  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([cartId, courseId])
  @@index([cartId])
  @@index([courseId])
  @@map("cart_items")
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  description    String?
  type           CouponType
  value          Decimal    @db.Decimal(10, 2)
  maxUses        Int?       @map("max_uses")
  usedCount      Int        @default(0) @map("used_count")
  maxUsesPerUser Int        @default(1) @map("max_uses_per_user")
  minOrderAmount Decimal?   @map("min_order_amount") @db.Decimal(10, 2)
  startsAt       DateTime?  @map("starts_at")
  expiresAt      DateTime?  @map("expires_at")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  carts   Cart[]
  courses CouponCourse[]

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model CouponCourse {
  id        String   @id @default(cuid())
  couponId  String   @map("coupon_id")
  courseId  String   @map("course_id")
  createdAt DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, courseId])
  @@index([couponId])
  @@index([courseId])
  @@map("coupon_courses")
}

enum CouponType {
  PERCENTAGE
  FIXED
}

// ─── Order & Payment Models ───────────────────────────────────────────────────

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique @map("order_number")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  subtotalCents Int      @map("subtotal_cents")
  discountCents Int      @default(0) @map("discount_cents")
  taxCents      Int      @default(0) @map("tax_cents")
  totalCents    Int      @map("total_cents")
  currency      Currency @default(USD)

  status OrderStatus @default(PENDING)

  couponId   String? @map("coupon_id")
  couponCode String? @map("coupon_code")

  checkoutFingerprint String? @map("checkout_fingerprint")

  paymentId String?  @unique @map("payment_id")
  payment   Payment? @relation(fields: [paymentId], references: [id])

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  items            OrderItem[]
  checkoutSessions CheckoutSession[]
  invoice          Invoice?

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([userId, status, checkoutFingerprint])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  priceCents Int             @map("price_cents")
  currency   Currency        @default(USD)
  status     OrderItemStatus @default(ACTIVE)
  refundedAt DateTime?       @map("refunded_at")

  refundRequest RefundRequest?
  earning       InstructorEarning?

  @@index([orderId])
  @@index([courseId])
  @@index([status])
  @@map("order_items")
}

enum OrderItemStatus {
  ACTIVE
  REFUND_PENDING
  REFUNDED
  FINALIZED
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  VOIDED
}

model Payment {
  id String @id @default(cuid())

  provider              PaymentProvider @default(PAYMOB)
  providerTransactionId String?         @map("provider_transaction_id")
  providerMetadata      Json?           @map("provider_metadata")

  amountCents Int      @map("amount_cents")
  currency    Currency @default(USD)

  status PaymentStatus @default(PENDING)

  paymentMethod String? @map("payment_method")
  integrationId Int?    @map("integration_id")
  last4         String?
  brand         String?

  failureCode    String? @map("failure_code")
  failureMessage String? @map("failure_message")

  /// Reconcile control plane (not money state)
  reconcileStatus          PaymentReconcileStatus @default(IDLE) @map("reconcile_status")
  reconcileAttemptCount    Int                    @default(0) @map("reconcile_attempt_count")
  consecutiveNotFoundCount Int                    @default(0) @map("consecutive_not_found_count")
  nextReconcileAt          DateTime?              @map("next_reconcile_at")
  reconcileLeaseExpiresAt  DateTime?              @map("reconcile_lease_expires_at")
  lastReconciledAt         DateTime?              @map("last_reconciled_at")
  lastProviderOutcome      String?                @map("last_provider_outcome")
  lastProviderDetail       String?                @map("last_provider_detail")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  paidAt    DateTime? @map("paid_at")

  order               Order?
  consultationBooking ConsultationBooking?
  refunds             Refund[]
  reconcileAttempts   PaymentReconcileAttempt[]
  disputes            PaymentDispute[]

  @@unique([provider, providerTransactionId])
  @@index([status])
  @@index([provider])
  @@index([nextReconcileAt])
  @@index([reconcileStatus])
  @@index([reconcileLeaseExpiresAt])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  VOIDED
}

enum PaymentReconcileStatus {
  IDLE
  SCHEDULED
  EXHAUSTED
  MANUAL_REVIEW
}

model PaymentReconcileAttempt {
  id        String  @id @default(cuid())
  paymentId String  @map("payment_id")
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  attempt       Int
  outcome       String
  decision      String?
  httpStatus    Int?    @map("http_status")
  detail        String?
  latencyMs     Int?    @map("latency_ms")
  correlationId String? @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([paymentId])
  @@index([createdAt])
  @@map("payment_reconcile_attempts")
}

enum PaymentDomainOutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model PaymentDomainOutbox {
  id          String                    @id @default(cuid())
  eventType   String                    @map("event_type")
  aggregateId String                    @map("aggregate_id")
  payload     Json
  status      PaymentDomainOutboxStatus @default(PENDING)
  createdAt   DateTime                  @default(now()) @map("created_at")
  publishedAt DateTime?                 @map("published_at")

  @@index([status, createdAt])
  @@map("payment_domain_outbox")
}

enum PaymentDisputeStatus {
