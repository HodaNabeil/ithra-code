# VPS production template — AI observability
# Copy relevant sections into your secrets manager / deployment env.
# See docs/ai-platform/production/otel-collector.config.yaml

# --- App + workers (Next.js + BullMQ) ---
NODE_ENV=production
AI_PLATFORM_ENABLED=true
AI_TUTOR_ENABLED=true

# OpenTelemetry (app + workers)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ithracode-ai-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_METRICS_PORT=9464
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# Optional batch span processor tuning (high traffic)
# OTEL_BSP_MAX_QUEUE_SIZE=2048
# OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
# OTEL_BSP_SCHEDULE_DELAY=5000

# LangSmith (agent debugging — separate from OTEL billing truth)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGSMITH_PII_SALT=rotate-me

# Admin analytics Bearer API (ops/Grafana scripts only — UI uses session auth)
AI_ADMIN_API_SECRET=replace-with-long-random-token

# Internal health probes
INTERNAL_HEALTH_TOKEN=replace-with-long-random-token

# Cost governance
# AI_PLATFORM_GLOBAL_DAILY_BUDGET_USD=50.00
# AI_PLATFORM_USER_DAILY_BUDGET_USD=1.00

# Optional pricing override without deploy
# AI_PLATFORM_MODEL_PRICING_JSON='{"gpt-4o-mini":{"input":0.00000015,"output":0.0000006}}'
