# =============================================================================
# IthraCode — Production environment for Vercel
# =============================================================================
# انسخ هذه القيم إلى: Vercel Dashboard → Project → Settings → Environment Variables
# لا ترفع هذا الملف بأسرار حقيقية إلى Git.
#
# Replace YOUR_DOMAIN with your Vercel URL or custom domain, e.g.:
#   https://ithracode.vercel.app
#   https://ithracode.com
# =============================================================================

# --- App ---
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://YOUR_DOMAIN"

# --- Database (Neon recommended — enable Vercel integration) ---
# Use the *pooler* URL for DATABASE_URL (serverless-friendly).
# Use the *direct* URL for DIRECT_URL (migrations only).
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"
# Run once in Neon SQL Editor: CREATE EXTENSION IF NOT EXISTS vector;

# --- Redis (Upstash recommended — enable Vercel integration) ---
REDIS_URL="rediss://default:PASSWORD@REGION.upstash.io:6379"

# --- Auth (Auth.js v5) ---
# Generate: openssl rand -hex 32
AUTH_SECRET="REPLACE_WITH_64_HEX_CHARS"
AUTH_URL="https://YOUR_DOMAIN"
AUTH_TRUST_HOST="true"
# Optional: set cookie domain for custom domain (e.g. .ithracode.com)
# COOKIE_DOMAIN=".ithracode.com"

# --- OAuth (update redirect URIs in provider consoles) ---
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID="REPLACE_WITH_GOOGLE_CLIENT_ID"
AUTH_GOOGLE_SECRET="REPLACE_WITH_GOOGLE_CLIENT_SECRET"
# GitHub: https://github.com/settings/developers
#   Callback URL: https://YOUR_DOMAIN/api/auth/callback/github
AUTH_GITHUB_ID="REPLACE_WITH_GITHUB_CLIENT_ID"
AUTH_GITHUB_SECRET="REPLACE_WITH_GITHUB_CLIENT_SECRET"

# --- Paymob (optional — omit if not used) ---
PAYMOB_API_URL="https://accept.paymob.com"
PAYMOB_SECRET_KEY="egy_sk_live_REPLACE_ME"
PAYMOB_PUBLIC_KEY="egy_pk_live_REPLACE_ME"
PAYMOB_HMAC_SECRET="REPLACE_WITH_HMAC_SECRET"
PAYMOB_API_KEY="REPLACE_WITH_LEGACY_API_KEY"
PAYMOB_INTEGRATION_IDS="REPLACE_WITH_INTEGRATION_ID"
# Webhook: https://YOUR_DOMAIN/api/payment/webhooks/paymob

# --- Mux (video) ---
MUX_TOKEN_ID="REPLACE_WITH_MUX_TOKEN_ID"
MUX_TOKEN_SECRET="REPLACE_WITH_MUX_TOKEN_SECRET"

# --- Email (Resend — recommended for production) ---
RESEND_API_KEY="re_REPLACE_ME"
PAYMENT_EMAIL_FROM="noreply@yourdomain.com"
CONTACT_NOTIFICATION_EMAIL="admin@yourdomain.com"

# --- Cloudflare Turnstile (required on production contact form) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY="REPLACE_WITH_TURNSTILE_SITE_KEY"
TURNSTILE_SECRET_KEY="REPLACE_WITH_TURNSTILE_SECRET_KEY"
TURNSTILE_USE_PRODUCTION_KEYS="true"

# --- AI Tutor / Platform ---
# On Vercel alone, background workers do NOT run. For first launch, disable AI:
AI_TUTOR_ENABLED="false"
AI_PLATFORM_ENABLED="false"
# When you deploy workers separately (Railway/Render/Fly), set both to "true" and add:
# OPENAI_API_KEY="sk-or-v1-REPLACE_ME"
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"
# AI_TUTOR_LLM_MODEL="openai/gpt-4o-mini"
# AI_TUTOR_EMBEDDING_MODEL="openai/text-embedding-3-small"
# AI_PLATFORM_LLM_MODEL="openai/gpt-4o-mini"
# AI_PLATFORM_EMBEDDING_MODEL="openai/text-embedding-3-small"

# --- Observability (keep off on Vercel serverless) ---
OTEL_ENABLED="false"

# --- Internal tokens (generate random strings) ---
# INTERNAL_HEALTH_TOKEN="REPLACE_WITH_RANDOM_TOKEN"
# AI_ADMIN_API_SECRET="REPLACE_WITH_RANDOM_TOKEN"
# PAYMENT_RECONCILE_ADMIN_SECRET="REPLACE_WITH_RANDOM_TOKEN"
