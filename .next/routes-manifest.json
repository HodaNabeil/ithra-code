      "page": "/admin/courses/[slug]/manage/goals",
      "regex": "^/admin/courses/([^/]+?)/manage/goals(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/admin/courses/(?<nxtPslug>[^/]+?)/manage/goals(?:/)?$"
    },
    {
      "page": "/api/auth/[...nextauth]",
