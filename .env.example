# --- Environment Variables ---
# Copy this file to .env and fill in real values from your secrets manager.
# NEVER commit .env or real secret values to Git.
# See docs/security/SECRETS_ROTATION.md for rotation instructions.

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# Redis (BullMQ / Caching)
REDIS_URL="redis://USER:PASSWORD@HOST:PORT"

# Auth (Auth.js v5)
# Generate with: openssl rand -hex 32
AUTH_SECRET="REPLACE_WITH_64_HEX_CHARS"
AUTH_URL="http://localhost:3000/api/auth"

# OAuth Providers
# Google: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="REPLACE_WITH_GOOGLE_CLIENT_ID"
AUTH_GOOGLE_SECRET="REPLACE_WITH_GOOGLE_CLIENT_SECRET"

# GitHub: https://github.com/settings/developers
AUTH_GITHUB_ID="REPLACE_WITH_GITHUB_CLIENT_ID"
AUTH_GITHUB_SECRET="REPLACE_WITH_GITHUB_CLIENT_SECRET"

# Stripe
# https://dashboard.stripe.com/apikeys
STRIPE_API_KEY="sk_test_REPLACE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"

# Paymob
# Settings → API Keys (Secret + Public) | Webhooks → HMAC Secret | Developers → Integration ID
PAYMOB_API_URL="https://accept.paymob.com"
PAYMOB_SECRET_KEY="egy_sk_test_REPLACE_ME"
PAYMOB_PUBLIC_KEY="egy_pk_test_REPLACE_ME"
PAYMOB_HMAC_SECRET="REPLACE_WITH_HMAC_SECRET"
PAYMOB_API_KEY="REPLACE_WITH_LEGACY_API_KEY"
PAYMOB_INTEGRATION_IDS="REPLACE_WITH_INTEGRATION_ID"
PAYMOB_RETRY_MAX=3
PAYMOB_RETRY_INITIAL_MS=1000
PAYMOB_TIMEOUT_MS=15000

# Mux (Video Streaming)
# https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID="REPLACE_WITH_MUX_TOKEN_ID"
MUX_TOKEN_SECRET="REPLACE_WITH_MUX_TOKEN_SECRET"

# AI Tutor (OpenRouter or OpenAI)
# OpenRouter: https://openrouter.ai/keys
AI_TUTOR_ENABLED=true
OPENAI_API_KEY="sk-or-v1-REPLACE_ME"
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
AI_TUTOR_LLM_MODEL="openai/gpt-4o-mini"
AI_TUTOR_EMBEDDING_MODEL="openai/text-embedding-3-small"

# AI Platform (required when AI Tutor is enabled)
AI_PLATFORM_ENABLED=true
AI_PLATFORM_LLM_MODEL="openai/gpt-4o-mini"
AI_PLATFORM_EMBEDDING_MODEL="openai/text-embedding-3-small"
AI_PLATFORM_DAILY_COST_CAP="1000"
# AI_PLATFORM_USER_DAILY_BUDGET_USD="1.00"
# AI_PLATFORM_GLOBAL_DAILY_BUDGET_USD="50.00"
# AI_TUTOR_USER_DAILY_BUDGET_USD="0.50"
AI_PLATFORM_RATE_LIMIT_PER_MINUTE="30"
AI_PLATFORM_RATE_LIMIT_PER_HOUR="300"
AI_PLATFORM_RATE_LIMIT_PER_DAY="1000"
# JSON override for per-model token pricing (USD per token): {"gpt-4o-mini":{"input":0.00000015,"output":0.0000006}}
# AI_PLATFORM_MODEL_PRICING_JSON=""

# Optional multi-provider keys (Phase 3)
# ANTHROPIC_API_KEY="sk-ant-REPLACE_ME"
# GOOGLE_AI_API_KEY="REPLACE_ME"

# Observability (optional)
# LANGFUSE_PUBLIC_KEY="pk-REPLACE_ME"
# LANGFUSE_SECRET_KEY="sk-REPLACE_ME"
# LANGCHAIN_TRACING_V2="false"
# LANGCHAIN_API_KEY="REPLACE_ME"
# OTEL_ENABLED="false"
# OTEL_SERVICE_NAME="ithracode-ai-platform"
# OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4318"
# OTEL_METRICS_PORT="9464"
# OTEL_TRACES_SAMPLER="parentbased_traceidratio"
# OTEL_TRACES_SAMPLER_ARG="1"
# OTEL_BSP_MAX_QUEUE_SIZE="2048"
# OTEL_BSP_MAX_EXPORT_BATCH_SIZE="512"
# OTEL_BSP_SCHEDULE_DELAY="5000"
# Production VPS template: docs/ai-platform/production/vps-observability.env.example

# Admin AI analytics API (Bearer auth for /api/admin/ai/* ops scripts)
# AI_ADMIN_API_SECRET="REPLACE_WITH_RANDOM_TOKEN"

# Internal health endpoint (production)
# INTERNAL_HEALTH_TOKEN="REPLACE_WITH_RANDOM_TOKEN"
